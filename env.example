# SMTP settings for contact form emails.
# Copy this file to .env and fill in your values. .env is gitignored.
#
# If these are not set, contact forms run in "email debug" mode: no mail is
# sent, but submissions are logged. Set EMAIL_DEBUG=0 to actually send mail
# when SMTP is configured.

# SMTP server
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls

# SMTP auth (required for sending)
SMTP_USER=
SMTP_PASS=

# Optional SMTP authentication method override.
# Common values: LOGIN, PLAIN
# SMTP_AUTH_TYPE=LOGIN

# From header (optional; defaults to SMTP_USER and sitename)
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=

# Set to 0 to send real mail when SMTP is configured. Omit or set to 1 for debug (no send, logs only).
# EMAIL_DEBUG=1

# SMTP verbosity:
# - When EMAIL_DEBUG=0 and SMTP is configured, default verbosity is enabled.
# - Set EMAIL_VERBOSE=0 if you want quieter logs.
# EMAIL_VERBOSE=1
